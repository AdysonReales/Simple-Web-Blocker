{
  "manifest_version": 3,
  "name": "Simple Web Blocker",
  "version": "2.0.0",
  "description": "Make space for focus with site blocks, schedules, and daily limits.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "src/background/index.js"},
  "icons": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"},
  "action": {"default_title": "Simple Web Blocker", "default_popup": "src/popup/index.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png"}}
}
